# Simulated Rihla travel API (services/travel_api.py) and its MCP server (services/travel_mcp.py)
TRAVEL_API_URL=http://localhost:8103
# Empty = the kit default dev-key-change-me. Use the same value for the API and the MCP server.
TRAVEL_API_KEY=
# replay (default, cache only, offline) | live (real upstream calls) | record (fill the cache)
TRAVEL_MODE=replay
# Fix "today" (YYYY-MM-DD) for the weather window. Empty: the cache's recording date in replay, real today otherwise.
TRAVEL_TODAY=
# Synthetic test overlays to switch on at start-up, comma-separated: price_conflict,prompt_injection
TRAVEL_OVERLAYS=
# Live/record mode only: your email or repo URL, sent in the User-Agent (OpenStreetMap usage policy)
TRAVEL_CONTACT=
# Optional: another cache folder
TRAVEL_CACHE_DIR=
# Keep saved trips across restarts (My Trips): a SQLite file, created on first use (docs/trip_store_persistence.md).
# Empty: in memory, erased on restart (what the eval runner and the tests expect). Git-ignored; never commit it.
TRAVEL_DB_PATH=
# Only for a throwaway test store: the key-less /admin endpoints are refused while TRAVEL_DB_PATH is set.
TRAVEL_ADMIN_ENDPOINTS=

# ---- Google sign-in (app/auth; docs: rihla-frontend/README.md "Google sign-in setup") ----
# Every sign-in is a Firebase ID token verified HERE (signature, issuer, audience = this project, expiry).
# The Firebase project whose Google sign-ins are accepted: Firebase console > Project settings > General > Project ID.
RIHLA_FIREBASE_PROJECT_ID=
# Signs the HttpOnly session cookie: at least 32 random characters, different per deployment. NEVER commit it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RIHLA_SESSION_SECRET=
# The web app's public config (Project settings > General > Your apps > Web app > SDK setup and configuration).
# Public by design (it identifies the project, grants nothing). The backend hands it to the browser through
# GET /api/auth/config. In development you can leave these two empty if rihla-frontend/.env.local has the
# VITE_FIREBASE_* values: the backend reads them from there. In production set them here: that file is not read.
# Never put a service-account key here. Check your setup with:  python -m app.auth.check
RIHLA_FIREBASE_WEB_API_KEY=
RIHLA_FIREBASE_APP_ID=
# Optional: default <project id>.firebaseapp.com
RIHLA_FIREBASE_AUTH_DOMAIN=
# true: planning, approval, My Trips and WHAT IF require a signed-in user (the web app). false (default): the
# official API contract stays open for the eval runner.
RIHLA_AUTH_REQUIRED=false
# Origins allowed to send cookie-carrying writes (CSRF), comma-separated: the URL you open Rihla at.
RIHLA_ALLOWED_ORIGINS=http://localhost:5173
# Optional: session length in hours (default 12); cookie Secure flag true/false/auto (default auto).
RIHLA_SESSION_TTL_HOURS=
RIHLA_COOKIE_SECURE=
# Keep logouts across backend restarts (a logged-out session cookie stays invalid): a SQLite file. Recommended.
# Empty: logouts are remembered until the backend restarts. Git-ignored like the Trip Store's file.
RIHLA_SESSION_DB_PATH=

# Rihla backend (app/main.py): the Trip Store traveller that approved trips are saved for and listed from
# (POST /api/approve, GET /api/trips). Without it, approval and My Trips' saved trips answer 503 and nothing
# is saved. Any id of letters, digits, - _ . (e.g. TRV-101, a fictional traveller in services/data).
TRAVEL_TRAVELLER_ID=

# Your agent (the kit does not use these)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4.1-mini

# Eval runner and UI starter: where your app runs (the runner reads TRAVEL_API_URL above for {TRAVEL_API})
APP_URL=http://localhost:8000
