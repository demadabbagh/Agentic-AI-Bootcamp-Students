# Copy this file to rihla-frontend/.env.local (git-ignored) and fill it in. Never commit .env.local.
# Vite reads it at start-up: restart `npm run dev` after a change.

# Live AI trip generation (off: the form explains that no trip was generated).
VITE_ENABLE_LIVE_AI=true

# Google sign-in through Firebase Authentication.
# Where to find the values: Firebase console > Project settings > General > Your apps > Web app >
# SDK setup and configuration. Ask the project owner, or use your own Firebase project.
# These four identify the project and are public by design (they grant nothing): every sign-in is verified by the
# backend. Never put a service-account key, the session secret or any other secret here.
#
# In development this file is all the web settings need: the backend reads these public values from here too, as
# long as VITE_FIREBASE_PROJECT_ID is the same as RIHLA_FIREBASE_PROJECT_ID in the backend .env (see ../.env.example).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
